# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud > App settings > Secrets. Never commit real keys.
RFP_PROVIDER = "anthropic"          # anthropic | openai | mock | mock_faulty
ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-5-5"

# OpenAI-compatible alternative (OpenAI, Groq, Gemini's OpenAI endpoint, Ollama, ...)
# OPENAI_API_KEY = "..."
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# OPENAI_MODEL = "gpt-4o-mini"
